// ==========================================
// VARIABLES GLOBALES
// ==========================================
Casilla[] tablero = new Casilla[9];

int VACIO = 0;
int ROJO = 1;
int AZUL = 2;

int turnoActual;
int estadoJuego; // 0 = Jugando, 1 = Ganó Rojo, 2 = Ganó Azul, 3 = Empate

int tiempoInicioTurno;
int limiteTiempo = 10000; // 10 segundos

int[][] lineasGanadoras = {
  {0, 1, 2}, {3, 4, 5}, {6, 7, 8}, // Filas
  {0, 3, 6}, {1, 4, 7}, {2, 5, 8}, // Columnas
  {0, 4, 8}, {2, 4, 6}             // Diagonales
};

// Variables para animación de personajes
float offsetYAzul = 0;
float offsetYRojo = 0;
float velYAzul = 0;
float velYRojo = 0;
float gravedad = 1.2;

// Botón de reinicio
float btnX, btnY, btnW, btnH;

void setup() {
  size(500, 500);
  rectMode(CORNER);
  
  btnX = width/2 - 60;
  btnY = 240;
  btnW = 120;
  btnH = 40;
  
  inicializarJuego();
}

void draw() {
  background(25, 28, 40);
  
  // Dibujar tablero (reubicado arriba)
  for (int i = 0; i < tablero.length; i++) {
    tablero[i].mostrar();
  }
  
  // Lógica de juego y HUD
  if (estadoJuego == 0) {
    int tiempoTranscurrido = millis() - tiempoInicioTurno;
    int tiempoRestante = max(0, (limiteTiempo - tiempoTranscurrido) / 1000);
    
    // Barra de tiempo
    float anchoBarra = map(limiteTiempo - tiempoTranscurrido, 0, limiteTiempo, 0, 300);
    anchoBarra = constrain(anchoBarra, 0, 300);
    fill(50);
    rect(100, 15, 300, 10, 5);
    fill(turnoActual == ROJO ? color(255, 46, 46) : color(31, 51, 255));
    rect(100, 15, anchoBarra, 10, 5);
    
    if (tiempoTranscurrido >= limiteTiempo) {
      cambiarTurno();
    }
  } else {
    // Texto de resultado
    textAlign(CENTER, CENTER);
    textSize(22);
    fill(255);
    if (estadoJuego == ROJO) text("¡¡GANÓ EL ROJO!!", width / 2, 210);
    else if (estadoJuego == AZUL) text("¡¡GANÓ EL AZUL!!", width / 2, 210);
    else if (estadoJuego == 3) text("¡¡EMPATE!!", width / 2, 210);
    
    // Botón de Reinicio
    fill(60, 65, 85);
    stroke(255);
    strokeWeight(2);
    rect(btnX, btnY, btnW, btnH, 10);
    noStroke();
    fill(255);
    textSize(16);
    text("REINICIAR", width/2, btnY + btnH/2);
  }
  
  // Actualizar fisicas de saltos
  actualizarPersonajes();
  
  // Dibujar a tus personajes en la base
  dibujarPersonajes();
}

// ==========================================
// INTERACCIÓN Y LÓGICA
// ==========================================
void mousePressed() {
  if (estadoJuego != 0) {
    // Click en botón de reinicio
    if (mouseX >= btnX && mouseX <= btnX + btnW && mouseY >= btnY && mouseY <= btnY + btnH) {
      inicializarJuego();
    }
    return;
  }
  
  for (int i = 0; i < tablero.length; i++) {
    if (tablero[i].contienePunto(mouseX, mouseY) && tablero[i].estaVacia()) {
      tablero[i].estado = turnoActual;
      
      // Salto al colocar ficha
      if (turnoActual == AZUL) velYAzul = -14;
      else if (turnoActual == ROJO) velYRojo = -14;
      
      if (verificarVictoria(turnoActual)) {
        estadoJuego = turnoActual;
      } else if (verificarEmpate()) {
        estadoJuego = 3;
      } else {
        cambiarTurno();
      }
      break;
    }
  }
}

void inicializarJuego() {
  float tamano = 95;
  float inicioX = 92;
  float inicioY = 35;
  
  for (int i = 0; i < 9; i++) {
    float x = inicioX + (i % 3) * (tamano + 10);
    float y = inicioY + (i / 3) * (tamano + 10);
    tablero[i] = new Casilla(x, y, tamano);
  }
  
  turnoActual = (int(random(2)) == 0) ? ROJO : AZUL;
  estadoJuego = 0;
  tiempoInicioTurno = millis();
}

void cambiarTurno() {
  turnoActual = (turnoActual == ROJO) ? AZUL : ROJO;
  tiempoInicioTurno = millis();
}

boolean verificarVictoria(int jugador) {
  for (int i = 0; i < lineasGanadoras.length; i++) {
    if (tablero[lineasGanadoras[i][0]].estado == jugador && 
        tablero[lineasGanadoras[i][1]].estado == jugador && 
        tablero[lineasGanadoras[i][2]].estado == jugador) {
      return true;
    }
  }
  return false;
}

boolean verificarEmpate() {
  for (int i = 0; i < tablero.length; i++) {
    if (tablero[i].estaVacia()) return false;
  }
  return true;
}

// ==========================================
// PERSONAJES Y ANIMACIONES
// ==========================================
void actualizarPersonajes() {
  // Aplicar gravedad a los saltos
  offsetYAzul += velYAzul;
  velYAzul += gravedad;
  if (offsetYAzul > 0) {
    offsetYAzul = 0;
    velYAzul = 0;
  }
  
  offsetYRojo += velYRojo;
  velYRojo += gravedad;
  if (offsetYRojo > 0) {
    offsetYRojo = 0;
    velYRojo = 0;
  }
  
  // Si un jugador gana, hace saltos continuos de victoria
  if (estadoJuego == AZUL && offsetYAzul == 0) velYAzul = -10;
  if (estadoJuego == ROJO && offsetYRojo == 0) velYRojo = -10;
}

void dibujarPersonajes() {
  noStroke();
  
  // ---------- PERSONAJE AZUL (Izquierda, tocando el piso) ----------
  pushMatrix();
  translate(10, 360 + offsetYAzul); // Base en y = 500
  
  fill(#1F33FF);
  circle(75, 65, 140); // Cabeza
  fill(#FFF7F7);
  ellipse(45, 50, 65, 40); // Ojo izquierdo
  ellipse(105, 50, 65, 40); // Ojo derecho
  popMatrix();
  
  // ---------- PERSONAJE ROJO (Derecha, tocando el piso) ----------
  pushMatrix();
  translate(350, 360 + offsetYRojo); // Base en y = 500
  
  fill(#FF2E2E);
  rect(0, 0, 140, 140, 16); // Cabeza
  fill(#FFF7F7);
  rect(0, 75, 60, 28); // Ojo izquierdo
  rect(80, 75, 60, 28); // Ojo derecho
  popMatrix();
}

// ==========================================
// CLASE CASILLA
// ==========================================
class Casilla {
  float x, y;
  float tamano;
  int estado;
  
  Casilla(float x, float y, float tamano) {
    this.x = x;
    this.y = y;
    this.tamano = tamano;
    this.estado = 0;
  }
  
  void mostrar() {
    // Color al pasar el mouse
    if (contienePunto(mouseX, mouseY) && estaVacia() && estadoJuego == 0) {
      fill(45, 50, 70);
    } else {
      fill(35, 38, 55);
    }
    
    stroke(70, 75, 100);
    strokeWeight(3);
    rect(x, y, tamano, tamano, 12);
    
    // Dibujar las figuras de los jugadores dentro de las casillas
    noStroke();
    if (estado == ROJO) {
      fill(#FF2E2E);
      rect(x + 18, y + 18, tamano - 36, tamano - 36, 8);
    } else if (estado == AZUL) {
      fill(#1F33FF);
      circle(x + tamano/2, y + tamano/2, tamano - 30);
    }
  }
  
  boolean contienePunto(float px, float py) {
    return (px >= x && px <= x + tamano && py >= y && py <= y + tamano);
  }
  
  boolean estaVacia() {
    return estado == 0;
  }
}
